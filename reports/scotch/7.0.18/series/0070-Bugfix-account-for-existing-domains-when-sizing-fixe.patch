From 803ea5aa5fc2ec8486267a24900ceb9e8ebd0162 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Mon, 2 Nov 2026 08:25:34 +0000
Subject: [PATCH 070/232] Bugfix: account for existing domains when sizing
 fixed vertex merging hash table [report PyScotch]

Since 22c9c42e, the hash table of `kgraphMapRbVfloMerge()` is sized
according to the maximum number of fixed domains only. However, all the
domains of the mapping computed on the non-fixed vertices are inserted
into it first. When there are few fixed vertices and many parts, e.g. a
single fixed vertex and 64 parts, the table fills up and the insertion
loop never terminates. Size the table according to the number of
existing domains plus the maximum number of fixed domains.

Add test cases with zero-load fixed vertices on distinct terminal
domains, and with a single fixed vertex mapped onto many domains.

Refs: GRA-01, PS3-G12-1
---
 src/check/test_scotch_graph_map.c | 66 ++++++++++++++++++++++++++++---
 src/libscotch/kgraph_map_rb.c     |  8 ++--
 2 files changed, 66 insertions(+), 8 deletions(-)

diff --git a/src/check/test_scotch_graph_map.c b/src/check/test_scotch_graph_map.c
index 04d38aef..07c2c165 100644
--- a/src/check/test_scotch_graph_map.c
+++ b/src/check/test_scotch_graph_map.c
@@ -41,7 +41,7 @@
 /**   DATES      : # Version 6.0  : from : 12 aug 2014     **/
 /**                                 to   : 17 jul 2024     **/
 /**                # Version 7.0  : from : 04 jul 2025     **/
-/**                                 to   : 11 apr 2026     **/
+/**                                 to   : 02 nov 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -118,22 +118,30 @@ main (
 int                 argc,
 char *              argv[])
 {
-  SCOTCH_Mapping      mappdat;                    /* Mapping to compute */
-  SCOTCH_Mapping      mapodat;                    /* Old mapping        */
+  SCOTCH_Mapping      mappdat;                    /* Mapping to compute                     */
+  SCOTCH_Mapping      mapodat;                    /* Old mapping                            */
   FILE *              fileptr;
   SCOTCH_Graph        grafdat;
+  SCOTCH_Graph        fixgrafdat;                 /* Graph with zero-load fixed vertices    */
   SCOTCH_Num          xdimsiz;
   int                 archnum;
   SCOTCH_Arch         archtab[ARCHNBR];
+  SCOTCH_Arch         fixarchdat;                 /* Architecture for fixed vertex mapping  */
   SCOTCH_Strat        stratab[STRANBR];
   int                 stranum;
   int                 typenum;
+  SCOTCH_Num          baseval;
   SCOTCH_Num          vertnbr;
   SCOTCH_Num          vertnum;
+  SCOTCH_Num *        verttab;
+  SCOTCH_Num *        vendtab;
+  SCOTCH_Num *        velotab;
+  SCOTCH_Num          edgenbr;
+  SCOTCH_Num *        edgetab;
   SCOTCH_Num *        parttab;
   SCOTCH_Num *        parotab;
   SCOTCH_Num *        vmlotab;
-  SCOTCH_Num *        vmloptr;                    /* vmlotab or NULL    */
+  SCOTCH_Num *        vmloptr;                    /* vmlotab or NULL                        */
   int                 o;
 
   SCOTCH_errorProg (argv[0]);
@@ -171,7 +179,8 @@ char *              argv[])
 
   if (((parttab = malloc (vertnbr * sizeof (SCOTCH_Num))) == NULL) ||
       ((parotab = malloc (vertnbr * sizeof (SCOTCH_Num))) == NULL) ||
-      ((vmlotab = malloc (vertnbr * sizeof (SCOTCH_Num))) == NULL)) {
+      ((vmlotab = malloc (vertnbr * sizeof (SCOTCH_Num))) == NULL) ||
+      ((velotab = malloc (vertnbr * sizeof (SCOTCH_Num))) == NULL)) {
     SCOTCH_errorPrint ("main: out of memory");
     exit (EXIT_FAILURE);
   }
@@ -291,12 +300,59 @@ char *              argv[])
 
   fclose (fileptr);
 
+  for (vertnum = 0; vertnum < vertnbr; vertnum ++) /* All vertices but one have zero loads */
+    velotab[vertnum] = 0;
+  velotab[vertnbr / 2] = 1;
+
+  SCOTCH_graphData (&grafdat, &baseval, NULL, &verttab, &vendtab, NULL, NULL, &edgenbr, &edgetab, NULL);
+  if ((SCOTCH_graphInit  (&fixgrafdat) != 0) ||   /* Build a copy of the graph with vertex loads */
+      (SCOTCH_graphBuild (&fixgrafdat, baseval, vertnbr, verttab, vendtab, velotab, NULL, edgenbr, edgetab, NULL) != 0)) {
+    SCOTCH_errorPrint ("main: cannot build graph with vertex loads");
+    exit (EXIT_FAILURE);
+  }
+  if ((SCOTCH_archInit  (&fixarchdat) != 0) ||
+      (SCOTCH_archCmplt (&fixarchdat, vertnbr) != 0)) { /* One terminal domain per vertex */
+    SCOTCH_errorPrint ("main: cannot initialize architecture");
+    exit (EXIT_FAILURE);
+  }
+
+  for (stranum = 0; stranum < STRANBR; stranum ++) {
+    printf ("Strat %d, zero-load fixed vertices\n", stranum);
+
+    for (vertnum = 0; vertnum < vertnbr; vertnum ++) /* Fix all vertices but the one with a non-zero load */
+      parttab[vertnum] = vertnum;                 /* Each fixed vertex belongs to a distinct terminal domain */
+    parttab[vertnbr / 2] = -1;
+
+    if (SCOTCH_graphMapFixed (&fixgrafdat, &fixarchdat, &stratab[stranum], parttab) != 0) {
+      SCOTCH_errorPrint ("main: cannot compute mapping with zero-load fixed vertices");
+      exit (EXIT_FAILURE);
+    }
+
+    checkMap (vertnbr, parttab, vertnbr, 0);
+
+    printf ("Strat %d, single fixed vertex\n", stranum);
+
+    memset (parttab, ~0, vertnbr * sizeof (SCOTCH_Num)); /* Map all vertices but one onto many terminal domains */
+    parttab[0] = 0;
+
+    if (SCOTCH_graphMapFixed (&grafdat, &fixarchdat, &stratab[stranum], parttab) != 0) {
+      SCOTCH_errorPrint ("main: cannot compute mapping with single fixed vertex");
+      exit (EXIT_FAILURE);
+    }
+
+    checkMap (vertnbr, parttab, vertnbr, 0);
+  }
+
+  SCOTCH_archExit  (&fixarchdat);
+  SCOTCH_graphExit (&fixgrafdat);
+
   for (archnum = 0; archnum < ARCHNBR; archnum ++)
     SCOTCH_archExit (&archtab[archnum]);
 
   for (stranum = 0; stranum < STRANBR; stranum ++)
    SCOTCH_stratExit (&stratab[stranum]);
 
+  free (velotab);
   free (vmlotab);
   free (parotab);
   free (parttab);
diff --git a/src/libscotch/kgraph_map_rb.c b/src/libscotch/kgraph_map_rb.c
index 542af13e..2e03c416 100644
--- a/src/libscotch/kgraph_map_rb.c
+++ b/src/libscotch/kgraph_map_rb.c
@@ -69,7 +69,7 @@
 /**                # Version 6.0  : from : 03 mar 2011     **/
 /**                                 to   : 21 jun 2019     **/
 /**                # Version 7.0  : from : 23 aug 2019     **/
-/**                                 to   : 19 oct 2026     **/
+/**                                 to   : 02 nov 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -403,6 +403,7 @@ const Anum * restrict const pfixtax)              /*+ Array of fixed vertex term
   Gnum                            vertnum;
   Gnum                            vertnnd;
   KgraphMapRbVfloHash * restrict  hashtab;        /* Hash table for merging fixed vertices */
+  Gnum                            hashnbr;        /* Prospective number of cells in table  */
   Gnum                            hashsiz;        /* Size of hash table                    */
   Gnum                            hashnum;
   Gnum                            hashmsk;        /* Mask for access to hash table         */
@@ -410,11 +411,12 @@ const Anum * restrict const pfixtax)              /*+ Array of fixed vertex term
   const Arch * restrict const archptr = mappptr->archptr;
   Anum * restrict const       parttax = mappptr->parttax;
 
-  for (hashmsk = 1; hashmsk < dfixmax; hashmsk = 2 * hashmsk + 1) ; /* Get upper power of two */
+  hashnbr = mappptr->domnnbr + dfixmax;           /* Existing domains plus fixed domains */
+  for (hashmsk = 1; hashmsk < hashnbr; hashmsk = 2 * hashmsk + 1) ; /* Get upper power of two */
   hashmsk = hashmsk * 4 + 3;                      /* Fill hash table at 25% maximum capacity  */
   hashsiz = hashmsk + 1;
 
-  if ((hashtab = memAlloc (hashsiz * sizeof (KgraphMapRbVfloHash))) == NULL) { /* Use fixed vertex load slots as hash slots */
+  if ((hashtab = memAlloc (hashsiz * sizeof (KgraphMapRbVfloHash))) == NULL) {
     errorPrint ("kgraphMapRbVfloMerge: out of memory (1)");
     return (1);
   }
