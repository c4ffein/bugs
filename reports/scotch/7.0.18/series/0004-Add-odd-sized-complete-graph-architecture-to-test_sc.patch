From 23e08ab978d9960ee83fa10458e1b4d3744f736b Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Mon, 2 Nov 2026 08:16:29 +0000
Subject: [PATCH 004/232] Add odd-sized complete graph architecture to
 `test_scotch_arch`

Sub-architectures of a complete graph with an odd number of vertices
coarsen through both passes of `archCmpltMatchMate()`, which a
matching that does not alternate passes, or that loses vertices, makes
fail.

Refs: COR-27
---
 src/check/test_scotch_arch.c | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/src/check/test_scotch_arch.c b/src/check/test_scotch_arch.c
index 3f0dd786..df351900 100644
--- a/src/check/test_scotch_arch.c
+++ b/src/check/test_scotch_arch.c
@@ -41,7 +41,7 @@
 /**   DATES      : # Version 6.0  : from : 25 jun 2014     **/
 /**                                 to   : 22 may 2018     **/
 /**                # Version 7.0  : from : 04 jul 2025     **/
-/**                                 to   : 11 jul 2026     **/
+/**                                 to   : 02 nov 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -61,7 +61,7 @@
 
 #include "scotch.h"
 
-#define ARCHNBR                     24
+#define ARCHNBR                     26
 
 /*********************/
 /*                   */
@@ -97,7 +97,12 @@ char *              argv[])
   }
 
   if (SCOTCH_archCmplt (&archtab[archnbr ++], 8) != 0) {
-    SCOTCH_errorPrint ("main: cannot create cmplt architecture");
+    SCOTCH_errorPrint ("main: cannot create cmplt architecture (1)");
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_archCmplt (&archtab[archnbr ++], 9) != 0) { /* Odd number of vertices to exercise alternate matching passes */
+    SCOTCH_errorPrint ("main: cannot create cmplt architecture (2)");
     exit (EXIT_FAILURE);
   }
 
