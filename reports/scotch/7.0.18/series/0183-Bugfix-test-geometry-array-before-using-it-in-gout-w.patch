From 358aa46803db7d4ba108c4bbf7989b138ff29416 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 16:07:10 +0000
Subject: [PATCH 183/232] Bugfix: test geometry array before using it in `gout`
 writers [report R. Perry]

The Tulip writer tested its based geometry access pointer against
NULL, which is never true for graphs of base 1 when no geometry is
provided, and then dereferenced it. Test the geometry array itself,
as the other writers do. Also, all four mesh writers computed the
based pointer before testing the array, which is undefined behavior
when the array is NULL: only compute it when the array exists, as
`archDeco2ArchBuild()` does for vertex loads.

Refs: CLI-16
---
 src/scotch/gout_o.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/scotch/gout_o.c b/src/scotch/gout_o.c
index 0964b7e2..659e1a60 100644
--- a/src/scotch/gout_o.c
+++ b/src/scotch/gout_o.c
@@ -278,7 +278,7 @@ FILE * const                fileptr)              /* Output stream
   const SCOTCH_Num * restrict const verttax = grafptr->verttax;
   const SCOTCH_Num * restrict const vendtax = grafptr->vendtax;
   const SCOTCH_Num * restrict const edgetax = grafptr->edgetax;
-  const C_GeoVert * restrict const  coortax = geomptr->coortab - baseval;
+  const C_GeoVert * restrict const  coortax = (geomptr->coortab != NULL) ? (geomptr->coortab - baseval) : NULL;
   const SCOTCH_Num * restrict const parttax = mappptr->labltab - baseval;
 
   if (geomptr->coortab == NULL) {
@@ -570,7 +570,7 @@ FILE * const                fileptr)              /* Output stream
   const SCOTCH_Num * restrict const verttax = grafptr->verttax;
   const SCOTCH_Num * restrict const vendtax = grafptr->vendtax;
   const SCOTCH_Num * restrict const edgetax = grafptr->edgetax;
-  const C_GeoVert * restrict const  coortax = geomptr->coortab - baseval;
+  const C_GeoVert * restrict const  coortax = (geomptr->coortab != NULL) ? (geomptr->coortab - baseval) : NULL;
   const SCOTCH_Num * restrict const parttax = mappptr->labltab - baseval;
 
   if (geomptr->coortab == NULL) {
@@ -921,10 +921,10 @@ FILE * const                fileptr)              /* Output stream
   const SCOTCH_Num * restrict const verttax = grafptr->verttax;
   const SCOTCH_Num * restrict const vendtax = grafptr->vendtax;
   const SCOTCH_Num * restrict const edgetax = grafptr->edgetax;
-  const C_GeoVert * restrict const  coortax = geomptr->coortab - baseval;
+  const C_GeoVert * restrict const  coortax = (geomptr->coortab != NULL) ? (geomptr->coortab - baseval) : NULL;
   const SCOTCH_Num * restrict const parttax = mappptr->labltab - baseval;
 
-  if (coortax == NULL) {
+  if (geomptr->coortab == NULL) {
     errorPrint ("outDrawTulMesh: geometry not provided");
     return (1);
   }
@@ -1068,7 +1068,7 @@ FILE * const                fileptr)              /* Output stream
   const SCOTCH_Num * restrict const verttax = grafptr->verttax;
   const SCOTCH_Num * restrict const vendtax = grafptr->vendtax;
   const SCOTCH_Num * restrict const edgetax = grafptr->edgetax;
-  const C_GeoVert * restrict const  coortax = geomptr->coortab - baseval;
+  const C_GeoVert * restrict const  coortax = (geomptr->coortab != NULL) ? (geomptr->coortab - baseval) : NULL;
   const SCOTCH_Num * restrict const parttax = mappptr->labltab - baseval;
 
   if (geomptr->coortab == NULL) {
