     errorPrint (STRINGIFY (SCOTCH_archMesh3) ": internal error");
@@ -442,8 +440,8 @@ const SCOTCH_Num            dimzval)
     return (1);
   }
 
-  if ((archsiz  = tgtarchdatptr->c[0], (archsiz * tgtarchdatptr->c[1]) < archsiz) ||
-      (archsiz *= tgtarchdatptr->c[1], (archsiz * tgtarchdatptr->c[2]) < archsiz)) {
+  if ((tgtarchdatptr->c[0] > (ANUMMAX / tgtarchdatptr->c[1])) || /* Number of terminals must fit in an Anum */
+      ((tgtarchdatptr->c[0] * tgtarchdatptr->c[1]) > (ANUMMAX / tgtarchdatptr->c[2]))) {
     errorPrint (STRINGIFY (SCOTCH_archMesh3) ": invalid architecture size");
