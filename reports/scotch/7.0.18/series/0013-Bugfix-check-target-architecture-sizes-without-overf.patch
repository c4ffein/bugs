   tgtarchdatptr->dimnnbr = dimnnbr;
   memCpy (tgtarchdatptr->c, dimntab, dimnnbr * sizeof (SCOTCH_Num)); /* Copy dimension array */
 
-  for (dimnnum = 1, archsiz = tgtarchdatptr->c[0]; dimnnum < tgtarchdatptr->dimnnbr; dimnnum ++) {
+  for (dimnnum = 0, archsiz = 1; dimnnum < tgtarchdatptr->dimnnbr; dimnnum ++) {
