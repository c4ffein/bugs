From 1d9dcfd92679e90bf47445c8c7d972be4624d061 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Mon, 2 Nov 2026 08:53:40 +0000
Subject: [PATCH 013/232] Bugfix: check target architecture sizes without
 overflowing [report R. Perry]

The size overflow checks of the mesh and torus loaders and builders
computed the product they were meant to guard, which is undefined
behavior for signed integers, and which, when it wraps around, does not
always yield a value smaller than the former one: e.g. "mesh2D 100000
50000" was accepted on 32-bit builds, and led to huge allocations when
mapping. The products are now checked beforehand.

Also, `SCOTCH_archTorus2()`, `SCOTCH_archTorus3()` and
`SCOTCH_archTorusX()` did not reject non-positive dimensions or
numbers of dimensions, nor did `SCOTCH_archMeshX()` check the first
dimension, unlike the mesh builders and the loaders; and the sum of
the vertex weights of weighted complete graph architectures was not
checked for overflow, neither by `archCmpltwArchLoad2()` nor by
`archCmpltwArchBuild2()`.

Refs: COR-21, PS3-G03-1
---
 src/libscotch/arch_cmpltw.c  | 10 ++++++++
 src/libscotch/arch_mesh.c    | 14 ++++-------
 src/libscotch/library_arch.c | 45 +++++++++++++++++++++++++-----------
 3 files changed, 46 insertions(+), 23 deletions(-)

diff --git a/src/libscotch/arch_cmpltw.c b/src/libscotch/arch_cmpltw.c
index 5a7ad2be..a0f3e639 100644
--- a/src/libscotch/arch_cmpltw.c
+++ b/src/libscotch/arch_cmpltw.c
@@ -184,6 +184,11 @@ const Anum * restrict const velotab)
       memFree    (vecwtab);
       return (1);
     }
+    if (veloval > (ANUMMAX - velosum)) {          /* Overall load must fit in an Anum */
+      errorPrint ("archCmpltwArchBuild2: invalid parameters (3)");
+      memFree    (vecwtab);
+      return (1);
+    }
 
     velosum += veloval;
     vecwtab[vertnum].veloval = veloval;
@@ -255,6 +260,11 @@ FILE * restrict const       stream)
       memFree    (vecwtab);
       return (1);
     }
+    if (veloval > (ANUMMAX - velosum)) {          /* Overall load must fit in an Anum */
+      errorPrint ("archCmpltwArchLoad2: bad input (3)");
+      memFree    (vecwtab);
+      return (1);
+    }
 
     velosum += veloval;
     vecwtab[vertnum].veloval = veloval;
diff --git a/src/libscotch/arch_mesh.c b/src/libscotch/arch_mesh.c
index c84801ec..57b62a8c 100644
