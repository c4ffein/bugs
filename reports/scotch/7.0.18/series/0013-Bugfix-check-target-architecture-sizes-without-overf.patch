 /**                                 to   : 15 may 2018     **/
 /**                # Version 7.0  : from : 19 feb 2018     **/
-/**                                 to   : 19 oct 2026     **/
+/**                                 to   : 02 nov 2026     **/
 /**                                                        **/
 /**   NOTES      : # The vertices of the (dX,dY) mesh are  **/
 /**                  numbered as terminals so that         **/
@@ -105,8 +105,6 @@ archMesh2ArchLoad (
 ArchMesh2 * restrict const  archptr,
 FILE * restrict const       stream)
 {
-  Anum                archsiz;
-
 #ifdef SCOTCH_DEBUG_ARCH1
   if ((sizeof (ArchMesh2)    > sizeof (ArchDummy)) ||
       (sizeof (ArchMesh2Dom) > sizeof (ArchDomDummy))) {
@@ -124,7 +122,7 @@ FILE * restrict const       stream)
   }
   archptr->dimnnbr = 2;
 
-  if (archsiz = archptr->c[0], (archsiz * archptr->c[1]) < archsiz) {
+  if (archptr->c[0] > (ANUMMAX / archptr->c[1])) { /* Number of terminals must fit in an Anum */
     errorPrint ("archMesh2ArchLoad: invalid architecture size");
     return (1);
   }
@@ -384,8 +382,6 @@ archMesh3ArchLoad (
 ArchMesh3 * restrict const  archptr,
 FILE * restrict const       stream)
 {
-  Anum                archsiz;
-
 #ifdef SCOTCH_DEBUG_ARCH1
   if ((sizeof (ArchMesh3)    > sizeof (ArchDummy)) ||
       (sizeof (ArchMesh3Dom) > sizeof (ArchDomDummy))) {
@@ -405,8 +401,8 @@ FILE * restrict const       stream)
   }
   archptr->dimnnbr = 3;
 
-  if ((archsiz  = archptr->c[0], (archsiz * archptr->c[1]) < archsiz) ||
-      (archsiz *= archptr->c[1], (archsiz * archptr->c[2]) < archsiz)) {
+  if ((archptr->c[0] > (ANUMMAX / archptr->c[1])) || /* Number of terminals must fit in an Anum */
+      ((archptr->c[0] * archptr->c[1]) > (ANUMMAX / archptr->c[2]))) {
     errorPrint ("archMesh3ArchLoad: invalid architecture size");
     return (1);
   }
@@ -664,7 +660,7 @@ FILE * restrict const       stream)
   }
 
   for (dimnnum = 1, archsiz = archptr->c[0]; dimnnum < archptr->dimnnbr; dimnnum ++) {
-    if ((archsiz * archptr->c[dimnnum]) < archsiz) {
+    if (archsiz > (ANUMMAX / archptr->c[dimnnum])) { /* Number of terminals must fit in an Anum */
       errorPrint ("archMeshXArchLoad: invalid architecture size");
       return (1);
     }
diff --git a/src/libscotch/library_arch.c b/src/libscotch/library_arch.c
