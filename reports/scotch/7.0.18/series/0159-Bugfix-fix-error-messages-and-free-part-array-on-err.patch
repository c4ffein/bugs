From d059d114c8d8a77ca1d4df4be3ccfd58409eb9dc Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Mon, 2 Nov 2026 08:33:04 +0000
Subject: [PATCH 159/232] Bugfix: fix error messages and free part array on
 error in `vdgraphCheck()` [report PyScotch]

Several error messages of `vdgraphCheck()` bore the name of the
sequential routine, and the two load tests added recently printed the
messages of the size tests. Name the routine and the loads properly.

On inconsistent global data, `vdgraphCheck()` and its twin
`bdgraphCheck()` returned without freeing their local part array.

Refs: PS2-G23-3, PS2-G22-4
---
 src/libscotch/bdgraph_check.c |  5 ++++-
 src/libscotch/vdgraph_check.c | 11 ++++++-----
 2 files changed, 10 insertions(+), 6 deletions(-)

diff --git a/src/libscotch/bdgraph_check.c b/src/libscotch/bdgraph_check.c
index 4fc7cdea..fa1ded8a 100644
--- a/src/libscotch/bdgraph_check.c
+++ b/src/libscotch/bdgraph_check.c
@@ -1,4 +1,4 @@
-/* Copyright 2007,2008,2011,2013,2014 IPB, Universite de Bordeaux, INRIA & CNRS
+/* Copyright 2007,2008,2011,2013,2014,2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -44,6 +44,8 @@
 /**                                 to   : 22 jul 2008     **/
 /**                # Version 6.0  : from : 03 sep 2011     **/
 /**                                 to   : 31 aug 2014     **/
+/**                # Version 7.0  : from : 02 nov 2026     **/
+/**                                 to   : 02 nov 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -191,6 +193,7 @@ const Bdgraph * restrict const grafptr)
       (reduglbtab[17] != - reduglbtab[16]) ||
       (reduglbtab[19] != - reduglbtab[18])) {
     errorPrint ("bdgraphCheck: inconsistent global graph data");
+    memFree    (partgsttax);                      /* Free yet unbased group leader */
     return     (1);
   }
 
diff --git a/src/libscotch/vdgraph_check.c b/src/libscotch/vdgraph_check.c
index cf90a9f0..4f628c80 100644
--- a/src/libscotch/vdgraph_check.c
+++ b/src/libscotch/vdgraph_check.c
@@ -42,7 +42,7 @@
 /**   DATES      : # Version 5.0  : from : 07 feb 2006     **/
 /**                                 to   : 01 mar 2008     **/
 /**                # Version 7.0  : from : 20 jan 2023     **/
-/**                                 to   : 31 oct 2023     **/
+/**                                 to   : 02 nov 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -105,7 +105,7 @@ const Vdgraph * const       grafptr)
   }
 
   if ((grafptr->complocload[0] + grafptr->complocload[1] + grafptr->complocload[2]) != grafptr->s.velolocsum) {
-    errorPrint ("vdgraphCheck: invalid local size sum");
+    errorPrint ("vdgraphCheck: invalid local load sum");
     cheklocval |= 4;
   }
 
@@ -189,6 +189,7 @@ const Vdgraph * const       grafptr)
       (reduglbtab[7] != - reduglbtab[6]) ||
       (reduglbtab[9] != - reduglbtab[8])) {
     errorPrint ("vdgraphCheck: inconsistent global graph data");
+    memFree (partgsttax);                         /* Free yet unbased array */
     return (1);
   }
 
@@ -236,14 +237,14 @@ const Vdgraph * const       grafptr)
       ((complocsize[0] != grafptr->complocsize[0]) ||
        (complocsize[1] != grafptr->complocsize[1]) ||
        (complocsize[2] != grafptr->complocsize[2]))) {
-    errorPrint ("vgraphCheck: invalid local part sizes");
+    errorPrint ("vdgraphCheck: invalid local part sizes");
     cheklocval = 1;
   }
   if ((cheklocval == 0) &&
       ((complocload[0] != grafptr->complocload[0]) ||
        (complocload[1] != grafptr->complocload[1]) ||
        (complocload[2] != grafptr->complocload[2]))) {
-    errorPrint ("vgraphCheck: invalid local part sizes");
+    errorPrint ("vdgraphCheck: invalid local part loads");
     cheklocval = 1;
   }
 
@@ -271,7 +272,7 @@ const Vdgraph * const       grafptr)
   if ((grafptr->compglbsize[0] != reduglbtab[3]) ||
       (grafptr->compglbsize[1] != reduglbtab[4]) ||
       (grafptr->compglbsize[2] != reduglbtab[5])) {
-    errorPrint ("vgraphCheck: invalid global part sizes");
+    errorPrint ("vdgraphCheck: invalid global part sizes");
     cheklocval = 1;
   }
 
-- 
2.43.0

