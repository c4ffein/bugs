From 5169c3fb9e11379883c5b496ac7ce864e4f922ae Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 13:35:49 +0000
Subject: [PATCH 102/232] Bugfix: compute pseudo-diameters of single-vertex
 components in `SCOTCH_graphMapView()` [report R. Perry]

Since a09f3249, `graphMapView3()` starts each connected component
from the previous distance but increments `distmax` beforehand, so
that a component made of a single vertex has a diameter of one:
every part of a mapping with one vertex per part has a pseudo-
diameter of one instead of zero, and a part made of two isolated
vertices one of two.

`distmax` now starts from `-1` and is incremented before use, so
that the first component starts from distance zero and every other
component from one past the previous diameter, as if components
were linked by an edge. The return values are documented.

Refs: API-14
---
 src/libscotch/library_graph_map_view.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/src/libscotch/library_graph_map_view.c b/src/libscotch/library_graph_map_view.c
index e91fe15c..8e7d667c 100644
--- a/src/libscotch/library_graph_map_view.c
+++ b/src/libscotch/library_graph_map_view.c
@@ -56,7 +56,7 @@
 /**                # Version 6.1  : from : 01 jul 2021     **/
 /**                                 to   : 01 jul 2021     **/
 /**                # Version 7.0  : from : 07 may 2019     **/
-/**                                 to   : 28 oct 2026     **/
+/**                                 to   : 02 nov 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -84,10 +84,11 @@
 /************************************/
 
 /* This routine computes the pseudo-diameter of
-** the given part.
+** the given part. Connected components of the
+** part are considered as linked by an edge.
 ** It returns:
-** - 0   : on success.
-** - !0  : on error.
+** - >=0 : pseudo-diameter of the part.
+** - -1  : on error.
 */
 
 static
@@ -122,7 +123,7 @@ const Anum                  partval)              /*+ Part (index) value +*/
   vendtax  = grafptr->vendtax;
   vexxtax -= grafptr->baseval;
 
-  distmax = 0;                                    /* Start distances from zero                  */
+  distmax = -1;                                   /* First component starts from distance zero  */
   for (passnum = 1, rootnum = grafptr->baseval; ; passnum ++) { /* For all connected components */
     Gnum                diamnum;                  /* Vertex which achieves diameter             */
 
@@ -133,8 +134,8 @@ const Anum                  partval)              /*+ Part (index) value +*/
     if (rootnum >= grafptr->vertnnd)              /* Exit if all of graph processed */
       break;
 
-    connval = distmax ++;                         /* Start from previous distance */
-    diamnum = rootnum;                            /* Start from found root        */
+    connval = ++ distmax;                         /* Start one past previous distance */
+    diamnum = rootnum;                            /* Start from found root            */
 
     for (flagval = 1; flagval -- != 0; passnum ++) { /* Loop if modifications   */
       graphMapViewQueueFlush (&queudat);          /* Flush vertex queue         */
