From 55b1ca96a4c205665b257b3d23ae21028c951746 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 13:09:54 +0000
Subject: [PATCH 012/232] Bugfix: free the right array on invalid weights in
 `archCmpltwArchBuild2()` [report PyScotch]

When a weight of a weighted complete graph architecture was not strictly
positive, `archCmpltwArchBuild2()` freed the weight array it had been
given, which belongs to the caller of `SCOTCH_archCmpltw()` or is the
temporary array of `archCmpltwArchLoad2()`, instead of the load array it
had just allocated, which leaked.

Refs: PS2-G02-arch-tleaf-hcub-build-1
---
 src/libscotch/arch_cmpltw.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/libscotch/arch_cmpltw.c b/src/libscotch/arch_cmpltw.c
index 58add399..5a7ad2be 100644
--- a/src/libscotch/arch_cmpltw.c
+++ b/src/libscotch/arch_cmpltw.c
@@ -44,7 +44,7 @@
 /**                # Version 6.0  : from : 14 feb 2011     **/
 /**                                 to   : 12 apr 2015     **/
 /**                # Version 7.0  : from : 18 feb 2018     **/
-/**                                 to   : 11 jul 2026     **/
+/**                                 to   : 02 nov 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -181,7 +181,7 @@ const Anum * restrict const velotab)
     veloval = velotab[vertnum];
     if (veloval <= 0) {                           /* Target weights cannot be negative nor null */
       errorPrint ("archCmpltwArchBuild2: invalid parameters (2)");
-      memFree    (velotab);
+      memFree    (vecwtab);
       return (1);
     }
 
