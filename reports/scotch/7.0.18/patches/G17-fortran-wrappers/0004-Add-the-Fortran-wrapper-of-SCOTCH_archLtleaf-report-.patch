From 3a1582d662831dc732ac2a4dc4356067cce60d6b Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 13:44:13 +0000
Subject: [PATCH 4/7] Add the Fortran wrapper of `SCOTCH_archLtleaf()` [report
 PyScotch]

The Scotch user's manual documents "scotchfarchltleaf", which was never
defined in "library_arch_f.c". The wrapper mirrors that of
`SCOTCH_archTleaf()`, with the permutation count and array added.

This commit requires `SCOTCH_archLtleaf()` to be declared in "library.h"
(see the commit "Declare `SCOTCH_archLtleaf()` in the library header").

Refs: API-24, PS2-G02-2
---
 src/libscotch/library_arch_f.c | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/src/libscotch/library_arch_f.c b/src/libscotch/library_arch_f.c
index 66d82b9b..7743a40e 100644
--- a/src/libscotch/library_arch_f.c
+++ b/src/libscotch/library_arch_f.c
@@ -50,7 +50,7 @@
 /**                # Version 6.1  : from : 15 mar 2021     **/
 /**                                 to   : 15 mar 2021     **/
 /**                # Version 7.0  : from : 21 jan 2023     **/
-/**                                 to   : 31 oct 2026     **/
+/**                                 to   : 02 nov 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -298,6 +298,24 @@ int * const                 revaptr), \
 **
 */
 
+SCOTCH_FORTRAN (                      \
+ARCHLTLEAF, archltleaf, (             \
+SCOTCH_Arch * const         archptr,  \
+const SCOTCH_Num * const    levlnbr,  \
+const SCOTCH_Num * const    sizetab,  \
+const SCOTCH_Num * const    linktab,  \
+const SCOTCH_Num * const    permnbr,  \
+const SCOTCH_Num * const    permtab,  \
+int * const                 revaptr), \
+(archptr, levlnbr, sizetab, linktab, permnbr, permtab, revaptr))
+{
+  *revaptr = SCOTCH_archLtleaf (archptr, *levlnbr, sizetab, linktab, *permnbr, permtab);
+}
+
+/*
+**
+*/
+
 SCOTCH_FORTRAN (                      \
 ARCHMESH2, archmesh2, (               \
 SCOTCH_Arch * const         archptr,  \
-- 
