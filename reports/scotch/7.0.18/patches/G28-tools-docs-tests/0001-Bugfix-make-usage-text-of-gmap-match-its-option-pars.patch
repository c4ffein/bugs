From 919e255dc27f788c624a42e161b8f89cd83dddad Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 16:13:28 +0000
Subject: [PATCH 1/9] Bugfix: make usage text of `gmap' match its option parser
 [report R. Perry]

The usage text of `gmap'/`gpart' announced a default load imbalance
tolerance of 0.05 while `kbalval' is initialized to 0.01, and invalid
strategy selection letters were reported as following option '-C'
instead of '-c'.

Refs: CLI-20
---
 src/scotch/gmap.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/scotch/gmap.c b/src/scotch/gmap.c
index edbd5e3a..43f3bb76 100644
--- a/src/scotch/gmap.c
+++ b/src/scotch/gmap.c
@@ -1,4 +1,4 @@
-/* Copyright 2004,2007,2008,2010-2012,2014,2018-2021,2023 IPB, Universite de Bordeaux, INRIA & CNRS
+/* Copyright 2004,2007,2008,2010-2012,2014,2018-2021,2023,2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -68,7 +68,7 @@
 /**                # Version 6.0  : from : 29 may 2010     **/
 /**                                 to   : 26 aug 2020     **/
 /**                # Version 7.0  : from : 10 oct 2021     **/
-/**                                 to   : 21 jan 2023     **/
+/**                                 to   : 02 nov 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -102,7 +102,7 @@ static File                 C_fileTab[C_FILENBR] = { /* File array
 static const char *         C_usageList[] = {     /* Usage */
   "gmap [<input source file> [<input target file> [<output mapping file> [<output log file>]]]] <options>",
   "gpart [<nparts/pwght>] [<input source file> [<output mapping file> [<output log file>]]] <options>",
-  "  -b<val>    : Load imbalance tolerance (default: 0.05)",
+  "  -b<val>    : Load imbalance tolerance (default: 0.01)",
   "  -C<opt>    : Choose execution context options according to one or several of <opt>:",
   "                 d  : deterministic behavior (even across multiple threads; implies 'f')",
   "                 f  : fixed random seed",
@@ -247,7 +247,7 @@ char *                      argv[])
                 straval |= SCOTCH_STRATSAFETY;
                 break;
               default :
-                errorPrint ("main: invalid strategy selection option '%c' after '-C'", argv[i][j]);
+                errorPrint ("main: invalid strategy selection option '%c' after '-c'", argv[i][j]);
             }
           }
           break;
