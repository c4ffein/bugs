From a1d337ae541df60fdf3ea11f5c59a9df3749c6a4 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Mon, 2 Nov 2026 08:33:10 +0000
Subject: [PATCH 2/9] Bugfix: do not free tree-leaf arrays twice on loading
 errors [report R. Perry]

Since `archLoad()` cleans up through `archTleafArchFree()` when the
loading routine of a tree-leaf or labeled tree-leaf architecture fails,
the arrays freed by `archTleafArchLoad()` and `archLtleafArchLoad()` on
error were freed a second time, e.g. on a malformed level line or
permutation. The loading routines now leave the freeing of the arrays
they have allocated to `archTleafArchFree()`, which no longer assumes
that the tree part has been allocated.

Refs: COR-07, PS3-G02-1
---
 src/libscotch/arch_tleaf.c | 21 +++++++++------------
 1 file changed, 9 insertions(+), 12 deletions(-)

diff --git a/src/libscotch/arch_tleaf.c b/src/libscotch/arch_tleaf.c
index 094b0857..188cef7a 100644
--- a/src/libscotch/arch_tleaf.c
+++ b/src/libscotch/arch_tleaf.c
@@ -66,7 +66,7 @@
 /**                # Version 6.0  : from : 14 feb 2011     **/
 /**                                 to   : 03 may 2019     **/
 /**                # Version 7.0  : from : 19 feb 2018     **/
-/**                                 to   : 25 oct 2026     **/
+/**                                 to   : 02 nov 2026     **/
 /**                                                        **/
 /**   NOTES      : # The ltleaf architecture was proposed  **/
 /**                  by Emmanuel Jeannot and Francois      **/
@@ -132,15 +132,13 @@ FILE * restrict const       stream)
         (archptr->sizetab[levlnum] < 2)                     ||
         (archptr->linktab[levlnum] < 1)) {
       errorPrint ("archTleafArchLoad: bad input (2)");
-      memFree    (archptr->sizetab);
-      return (1);
+      return (1);                                 /* Tree part will be freed by archTleafArchFree() */
     }
   }
 
   for (levlnum = 0, archsiz = 1; levlnum < archptr->levlnbr; levlnum ++) {
     if ((archsiz * archptr->sizetab[levlnum]) < archsiz) {
       errorPrint ("archTleafArchLoad: invalid architecture size");
-      memFree    (archptr->sizetab);
       return (1);
     }
     archsiz *= archptr->sizetab[levlnum];
@@ -169,7 +167,8 @@ ArchTleaf * const           archptr)
   }
 #endif /* SCOTCH_DEBUG_ARCH1 */
 
-  memFree (archptr->sizetab);                     /* Free group leader */
+  if (archptr->sizetab != NULL)                   /* If tree part has been allocated */
+    memFree (archptr->sizetab);                   /* Free group leader               */
   if (archptr->permtab != NULL)
     memFree (archptr->permtab);                   /* Free group leader */
 
@@ -696,9 +695,7 @@ FILE * restrict const       stream)
   if ((intLoad (stream, &archptr->permnbr) != 1) ||
       (archptr->permnbr < 1)) {
     errorPrint ("archLtleafArchLoad: bad input (1)");
-fail:
-    memFree (archptr->sizetab);
-    return  (1);
+    return (1);                                   /* Arrays will be freed by archTleafArchFree() */
   }
 
   if (archptr->permnbr != 1) {                    /* Valid empty permutation is of size 1 */
@@ -709,14 +706,14 @@ fail:
          sizeval != archptr->permnbr; levlnum --, sizeval *= archptr->sizetab[levlnum]) {
       if (levlnum < 0) {
         errorPrint ("archLtleafArchLoad: permutation size does not match level boundaries");
-        goto fail;
+        return (1);
       }
     }
   }
 
   if ((archptr->permtab = memAlloc (archptr->permnbr * 2 * sizeof (Anum))) == NULL) { /* TRICK: space for peritab too */
     errorPrint ("archLtleafArchLoad: out of memory");
-    goto fail;
+    return (1);
   }
   archptr->peritab = archptr->permtab + archptr->permnbr;
 
@@ -726,12 +723,12 @@ fail:
         (archptr->permtab[permnum] < 0)                     ||
         (archptr->permtab[permnum] >= archptr->permnbr)) {
       errorPrint ("archLtleafArchLoad: bad input (2)");
-      goto fail;
+      return (1);
     }
 
     if (archptr->peritab[archptr->permtab[permnum]] != ~0) { /* Check and build inverse permutation */
       errorPrint ("archLtleafArchLoad: duplicate permutation index");
-      goto fail;
+      return (1);
     }
     archptr->peritab[archptr->permtab[permnum]] = permnum;
   }
