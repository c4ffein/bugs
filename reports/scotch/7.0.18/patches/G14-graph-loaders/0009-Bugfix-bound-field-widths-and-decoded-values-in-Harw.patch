From b8ca3890989544f2755a49aa669a396339fc9d89 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Mon, 2 Nov 2026 09:21:32 +0000
Subject: [PATCH 9/9] Bugfix: bound field widths and decoded values in
 Harwell-Boeing loader [report PyScotch]

The format parser of `graphGeomLoadHabo()` accumulated field counts
and widths without bound, and the fixed-width field readers kept
reading past the end of the file and accumulated digits in a signed
integer: a format such as (3I9999999999) made the loader spin on EOF,
and wide fields overflowed (undefined behavior). Reject format numbers
wider than a line, stop reading fields at end of file, and saturate
decoded values, which the range checks then reject.

Refs: PS2-G14-1
---
 src/libscotch/graph_io_habo.c | 17 ++++++++++-------
 src/libscotch/graph_io_habo.h |  9 +++++++--
 2 files changed, 17 insertions(+), 9 deletions(-)

diff --git a/src/libscotch/graph_io_habo.c b/src/libscotch/graph_io_habo.c
index 7465d665..4568cc6a 100644
--- a/src/libscotch/graph_io_habo.c
+++ b/src/libscotch/graph_io_habo.c
@@ -233,9 +233,9 @@ const char * const          dataptr)              /* Tag value        */
     }
 
     habcolval = (c == ' ') ? 0 : (c - '0');
-    for (habcolidx = 1; habcolidx < habcolfmt.datalen; habcolidx ++) {
+    for (habcolidx = 1; (habcolidx < habcolfmt.datalen) && (c != EOF); habcolidx ++) { /* Stop at end of file, whatever the field width */
       if ((c = getc (filesrcptr)) != ' ')
-        habcolval = habcolval * 10 + c - '0';
+        habcolval = ((habcolval >= 0) && (habcolval < GRAPHGEOMHABOVALMAX)) ? (habcolval * 10 + c - '0') : GNUMMAX; /* Saturate invalid values */
     }
     if (c == EOF) {
       errorPrint ("graphGeomLoadHabo: bad input (6)");
@@ -275,9 +275,9 @@ fail:
           c = getc (filesrcptr);
       }
       habnzrval = (c == ' ') ? 0 : (c - '0');
-      for (habnzridx = 1; habnzridx < habnzrfmt.datalen; habnzridx ++) {
+      for (habnzridx = 1; (habnzridx < habnzrfmt.datalen) && (c != EOF); habnzridx ++) { /* Stop at end of file, whatever the field width */
         if ((c = getc (filesrcptr)) != ' ')
-          habnzrval = habnzrval * 10 + c - '0';
+          habnzrval = ((habnzrval >= 0) && (habnzrval < GRAPHGEOMHABOVALMAX)) ? (habnzrval * 10 + c - '0') : GNUMMAX; /* Saturate invalid values */
       }
       if (c == EOF) {
         errorPrint ("graphGeomLoadHabo: bad input (8)");
@@ -399,7 +399,8 @@ const char * const                  dataptr)      /* Format string       */
       return (1);
     if (! isdigit ((int) (unsigned char) *charptr))
       break;
-    number = number * 10 + *charptr - '0';
+    if ((number = number * 10 + *charptr - '0') > GRAPHGEOMHABOLINESIZ) /* No field can be wider than a line */
+      return (1);
   }
 
   if ((*charptr == 'x') || (*charptr == 'X')) {   /* If dummy characters at beginning of line */
@@ -417,7 +418,8 @@ const char * const                  dataptr)      /* Format string       */
         return (1);
       if (! isdigit ((int) (unsigned char) *charptr))
         break;
-      number = number * 10 + *charptr - '0';
+      if ((number = number * 10 + *charptr - '0') > GRAPHGEOMHABOLINESIZ)
+        return (1);
     }
   }
 
@@ -432,7 +434,8 @@ const char * const                  dataptr)      /* Format string       */
       return (1);
     if (! isdigit ((int) (unsigned char) *charptr))
       break;
-    number = number * 10 + *charptr - '0';
+    if ((number = number * 10 + *charptr - '0') > GRAPHGEOMHABOLINESIZ) /* No field can be wider than a line */
+      return (1);
   }
 
   if (number == 0)
diff --git a/src/libscotch/graph_io_habo.h b/src/libscotch/graph_io_habo.h
index 132a21f3..c22bfd8c 100644
--- a/src/libscotch/graph_io_habo.h
+++ b/src/libscotch/graph_io_habo.h
@@ -1,4 +1,4 @@
-/* Copyright 2004,2007,2008,2018 IPB, Universite de Bordeaux, INRIA & CNRS
+/* Copyright 2004,2007,2008,2018,2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -50,7 +50,7 @@
 /**                # Version 5.1  : from : 09 nov 2008     **/
 /**                                 to   : 09 nov 2008     **/
 /**                # Version 6.0  : from : 07 jun 2018     **/
-/**                                 to   : 07 jun 2018     **/
+/**                                 to   : 02 nov 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -62,6 +62,11 @@
 
 #define GRAPHGEOMHABOHASHPRIME      7             /*+ Prime number +*/
 
+/*+ Bounds for reading fixed-width fields. +*/
+
+#define GRAPHGEOMHABOLINESIZ        80            /*+ Maximum field width: line width +*/
+#define GRAPHGEOMHABOVALMAX         ((GNUMMAX / 10) - 30) /*+ Bound for decoding without overflow +*/
+
 /*
 **  The type and structure definitions.
 */
