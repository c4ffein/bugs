From 5abd5bcada1e97f8d04761ab7ba8b3f71a3bd534 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 13:09:30 +0000
Subject: [PATCH 1/6] Add test for integer loading routine `intLoad()`

Check that `intLoad()` reads valid integers up to `INTVALMAX` in
absolute value, leaves the stream after the last digit, and rejects
without modifying the destination non-numeric input and values that
do not fit in an `INT`, e.g. `4294967298` when `INT` is 32-bit.

Refs: COR-15
---
 src/check/CMakeLists.txt        |   6 ++
 src/check/Makefile              |   9 ++
 src/check/test_common_integer.c | 158 ++++++++++++++++++++++++++++++++
 3 files changed, 173 insertions(+)
 create mode 100644 src/check/test_common_integer.c

diff --git a/src/check/CMakeLists.txt b/src/check/CMakeLists.txt
index 4b9bad80..dba3d930 100644
--- a/src/check/CMakeLists.txt
+++ b/src/check/CMakeLists.txt
@@ -127,6 +127,12 @@ foreach(ext "bz2" "gz" "lzma")
   endif(${_map_${ext}}_FOUND)
 endforeach()
 
+# test_common_integer
+
+add_test_scotch(test_common_integer)
+
+add_test(NAME test_common_integer COMMAND test_common_integer ${CMAKE_CURRENT_BINARY_DIR}/integer.dat)
+
 # test_common_random
 
 add_test_scotch(test_common_random)
diff --git a/src/check/Makefile b/src/check/Makefile
index b3570873..310c35d4 100644
--- a/src/check/Makefile
+++ b/src/check/Makefile
@@ -197,6 +197,7 @@ realclean			:	clean
 ##
 
 CHECKSCOTCH = 		check_common_file_compress		\
+			check_common_integer			\
 			check_common_random			\
 			check_common_thread			\
 			check_arch_deco				\
@@ -291,6 +292,14 @@ test_common_file_compress	:	test_common_file_compress.c	\
 
 ##
 
+check_common_integer		:	test_common_integer
+					$(EXECS) ./test_common_integer "$(TMPDIR)/integer.dat"
+
+test_common_integer		:	test_common_integer.c		\
+					$(SCOTCHLIBDIR)/libscotch$(LIB)
+
+##
+
 check_common_random		:	test_common_random
 					$(EXECS) ./test_common_random "$(TMPDIR)/rand.dat" 0
 					$(EXECS) ./test_common_random "$(TMPDIR)/rand.dat" 1
diff --git a/src/check/test_common_integer.c b/src/check/test_common_integer.c
new file mode 100644
index 00000000..0925dd5f
--- /dev/null
+++ b/src/check/test_common_integer.c
@@ -0,0 +1,158 @@
