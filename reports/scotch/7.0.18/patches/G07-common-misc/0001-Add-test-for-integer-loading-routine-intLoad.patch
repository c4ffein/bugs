+/*
+**  The defines and includes.
+*/
+
+#ifndef _XOPEN_SOURCE
+#define _XOPEN_SOURCE               600
+#endif /* _XOPEN_SOURCE */
+#ifndef __USE_XOPEN2K
+#define __USE_XOPEN2K                             /* For POSIX pthread_barrier_t */
+#endif /* __USE_XOPEN2K */
+
+#include "../libscotch/module.h"
+#include "../libscotch/common.h"
+
+#include "scotch.h"
+
+/*
+**  The type and structure definitions.
+*/
+
+typedef struct TestCase_ {
+  const char *              strgptr;              /*+ String to read      +*/
+  int                       retuval;              /*+ Expected return     +*/
+  long long                 valuval;              /*+ Expected value      +*/
+  int                       nextval;              /*+ Expected next char  +*/
+} TestCase;
+
+/*********************/
+/*                   */
+/* The main routine. */
+/*                   */
+/*********************/
+
+int
+main (
+int                 argc,
+char *              argv[])
+{
+  char                maxpstab[32];               /* Decimal string of INTVALMAX     */
+  char                maxnstab[32];               /* Decimal string of -INTVALMAX    */
+  char                ovfptab[32];                /* Decimal string of INTVALMAX + 1 */
+  char                ovfntab[32];                /* Decimal string of ten times INTVALMAX */
+  TestCase            testtab[16];
+  int                 testnbr;
+  int                 testnum;
+  FILE *              fileptr;
+
+  errorProg (argv[0]);
+
+  if (argc != 2) {
+    errorPrint ("usage: %s temp_file", argv[0]);
+    exit       (EXIT_FAILURE);
+  }
+
+  sprintf (maxpstab, "%lld",  (long long)  INTVALMAX);
+  sprintf (maxnstab, "-%lld", (long long)  INTVALMAX);
+  sprintf (ovfptab,  "%llu",  (unsigned long long) INTVALMAX + 1ULL);
+  sprintf (ovfntab,  "-%lld0", (long long) INTVALMAX);
+
+  testnbr = 0;
+  testtab[testnbr].strgptr = "0";        testtab[testnbr].retuval = 1; testtab[testnbr].valuval = 0;                        testtab[testnbr ++].nextval = EOF;
+  testtab[testnbr].strgptr = " \t-42x";  testtab[testnbr].retuval = 1; testtab[testnbr].valuval = -42;                      testtab[testnbr ++].nextval = 'x';
+  testtab[testnbr].strgptr = "+0017 ";   testtab[testnbr].retuval = 1; testtab[testnbr].valuval = 17;                       testtab[testnbr ++].nextval = ' ';
+  testtab[testnbr].strgptr = maxpstab;   testtab[testnbr].retuval = 1; testtab[testnbr].valuval = (long long) INTVALMAX;    testtab[testnbr ++].nextval = EOF;
+  testtab[testnbr].strgptr = maxnstab;   testtab[testnbr].retuval = 1; testtab[testnbr].valuval = - (long long) INTVALMAX;  testtab[testnbr ++].nextval = EOF;
+  testtab[testnbr].strgptr = ovfptab;    testtab[testnbr].retuval = 0; testtab[testnbr].valuval = 0;                        testtab[testnbr ++].nextval = EOF;
+  testtab[testnbr].strgptr = ovfntab;    testtab[testnbr].retuval = 0; testtab[testnbr].valuval = 0;                        testtab[testnbr ++].nextval = EOF;
+  testtab[testnbr].strgptr = "4294967298"; testtab[testnbr].retuval = (sizeof (INT) > 4) ? 1 : 0; testtab[testnbr].valuval = 4294967298LL; testtab[testnbr ++].nextval = EOF;
+  testtab[testnbr].strgptr = "99999999999999999999999"; testtab[testnbr].retuval = 0; testtab[testnbr].valuval = 0;       testtab[testnbr ++].nextval = EOF;
+  testtab[testnbr].strgptr = "-";        testtab[testnbr].retuval = 0; testtab[testnbr].valuval = 0;                        testtab[testnbr ++].nextval = EOF;
+  testtab[testnbr].strgptr = "abc";      testtab[testnbr].retuval = 0; testtab[testnbr].valuval = 0;                        testtab[testnbr ++].nextval = EOF;
+
+  for (testnum = 0; testnum < testnbr; testnum ++) {
+    INT                 valuval;
+    int                 o;
+
+    if ((fileptr = fopen (argv[1], "w+")) == NULL) {
+      errorPrint ("main: cannot open file");
+      exit       (EXIT_FAILURE);
+    }
+    if ((fputs (testtab[testnum].strgptr, fileptr) == EOF) ||
+        (fflush (fileptr) != 0)) {
+      errorPrint ("main: cannot write to file");
+      exit       (EXIT_FAILURE);
+    }
+    rewind (fileptr);
+
+    valuval = -1;
+    o = intLoad (fileptr, &valuval);
+    if (o != testtab[testnum].retuval) {
+      errorPrint ("main: invalid result for string \"%s\" (%d)", testtab[testnum].strgptr, o);
+      exit       (EXIT_FAILURE);
+    }
+    if (o == 1) {
+      if ((long long) valuval != testtab[testnum].valuval) {
+        errorPrint ("main: invalid value for string \"%s\" (" INTSTRING ")", testtab[testnum].strgptr, valuval);
+        exit       (EXIT_FAILURE);
+      }
+      if (getc (fileptr) != testtab[testnum].nextval) {
+        errorPrint ("main: invalid stream position for string \"%s\"", testtab[testnum].strgptr);
+        exit       (EXIT_FAILURE);
+      }
+    }
+    else if (valuval != -1) {                     /* Value must not be touched on error */
+      errorPrint ("main: value modified on error for string \"%s\"", testtab[testnum].strgptr);
+      exit       (EXIT_FAILURE);
+    }
+
+    fclose (fileptr);
+  }
+
+  exit (EXIT_SUCCESS);
+}
