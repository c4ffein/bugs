    #0 graphMapView2 library_graph_map_view.c:486
    #1 SCOTCH_graphRemapView library_graph_map_view.c:647
    #2 main remap.c:82      (run: ./remap 1, i.e. base 1)
  sh run.sh   with  SCOTCH_BUILD=<ASan+UBSan build of libscotch>   (remap.c is a copy of API-16/remap.c)
